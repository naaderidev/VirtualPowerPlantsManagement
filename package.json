{
  "name": "vpp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "lint:ci": "eslint --max-warnings 187",
    "test:security": "tsx --test src/lib/access-control.test.ts src/lib/ui-access.test.ts src/lib/notification-scope.test.ts src/components/ui/persian-date-picker.test.ts",
    "test:api": "tsx --test src/lib/api-contracts.test.ts src/lib/persian-date.test.ts src/lib/date-picker-constraints.test.ts",
    "test:workflow": "tsx --test src/domain/parties/*.test.ts src/domain/documents/*.test.ts src/domain/requests/*.test.ts src/domain/contracts/*.test.ts src/domain/assets/*.test.ts",
    "test:financial": "tsx --test src/domain/pricing/*.test.ts src/domain/metering/*.test.ts src/domain/settlement/*.test.ts src/domain/netting/*.test.ts src/domain/billing/*.test.ts src/domain/assets/generation-profile-workflow.test.ts",
    "test:ops": "node --test scripts/runtime-environment.test.mjs scripts/release-smoke.test.mjs",
    "test:seed": "tsx --test prisma/seed-users.test.ts",
    "test": "npm run test:security && npm run test:api && npm run test:workflow && npm run test:financial && npm run test:ops && npm run test:seed",
    "postinstall": "prisma generate",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore:verify": "node scripts/db-restore-verify.mjs",
    "db:jalali:dry-run": "node scripts/migrate-calendar-data-to-jalali.mjs",
    "db:jalali:migrate": "node scripts/migrate-calendar-data-to-jalali.mjs --apply",
    "db:jalali:backup": "node scripts/backup-calendar-data.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "prod:build": "npm run typecheck && npm run build",
    "prod:start": "node scripts/start-production.mjs",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "runtime:validate": "node scripts/validate-runtime-environment.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "verify": "npm run lint:ci && npm run typecheck && npm test && npm run db:validate && npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.8.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-multi-date-picker": "4.5.2",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
