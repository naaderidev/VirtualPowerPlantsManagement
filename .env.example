# Database Configuration
DATABASE_URL="mysql://root:password@localhost:3306/vpp"
# Dedicated empty database used only for restore drills; it must never equal DATABASE_URL.
RESTORE_DATABASE_URL="mysql://restore_user:password@localhost:3306/vpp_restore_drill"
# Optional absolute client paths when mysql/mysqldump are not available on PATH.
MYSQL_PATH="mysql"
MYSQLDUMP_PATH="mysqldump"
ALLOW_RESTORE="false"
ALLOW_PRODUCTION_BACKUP="false"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="برقتو"
APP_ENV="development"
RELEASE_ID="local-development"
# Public application origin used by authentication callbacks. Production must use HTTPS.

# Security
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
ENABLE_DEMO_LOGIN="false"
SEED_PASSWORD="set-a-development-only-password-of-at-least-12-characters"
ADMIN_SEED_PASSWORD="set-the-development-admin-password"
# Use your own admin mobile number (11 digits, starting with 09); never commit the real value.
ADMIN_SEED_MOBILE="09190000000"

# Email Configuration (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"
SMTP_FROM="noreply@beraguto.com"

# SMS Configuration (Optional)
SMS_API_KEY="your-sms-api-key"
SMS_API_SECRET="your-sms-api-secret"

# File Upload
UPLOAD_DIR="./storage/uploads"
MAX_FILE_SIZE="10485760"  # 10MB

# Rate Limiting
RATE_LIMIT_WINDOW="900000"  # 15 minutes
RATE_LIMIT_MAX="100"

# Logging
LOG_LEVEL="info"
LOG_DIR="./logs"

# Feature Flags
NETTING_ENABLED="false"
METER_IMPORT_ENABLED="false"
EXTERNAL_SIGNATURE_ENABLED="false"
PAYMENT_GATEWAY_ENABLED="false"

# Production Settings
NODE_ENV="development"
